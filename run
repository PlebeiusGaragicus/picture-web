#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
API_DIR="$ROOT_DIR/api"
WEBUI_DIR="$ROOT_DIR/webui"
VENV_DIR="$ROOT_DIR/.venv"
API_PORT="${API_PORT:-8787}"
WEB_PORT="${WEB_PORT:-5173}"

PIDS=()

cleanup() {
  local exit_code=$?
  if ((${#PIDS[@]})); then
    echo
    echo "Stopping dev servers..."
    for pid in "${PIDS[@]}"; do
      if kill -0 "$pid" 2>/dev/null; then
        # Stop direct children first so uvicorn reload workers and Vite
        # children do not survive after the parent shell exits.
        pkill -TERM -P "$pid" 2>/dev/null || true
        kill "$pid" 2>/dev/null || true
      fi
    done
    wait "${PIDS[@]}" 2>/dev/null || true
  fi
  exit "$exit_code"
}

trap cleanup EXIT INT TERM

need_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Missing required command: $1" >&2
    exit 1
  fi
}

need_command python3
need_command npm

echo "Setting up Python environment..."
if [[ ! -x "$VENV_DIR/bin/python" ]]; then
  python3 -m venv "$VENV_DIR"
fi
"$VENV_DIR/bin/python" -m pip install -r "$API_DIR/requirements.txt"

echo "Setting up web UI dependencies..."
(
  cd "$WEBUI_DIR"
  if [[ -f package-lock.json ]]; then
    npm install
  else
    npm install
  fi
)

echo "Starting FastAPI on http://127.0.0.1:$API_PORT"
(
  cd "$API_DIR"
  "$VENV_DIR/bin/uvicorn" main:app --reload --host 127.0.0.1 --port "$API_PORT"
) &
PIDS+=("$!")

echo "Starting Vite on http://127.0.0.1:$WEB_PORT"
(
  cd "$WEBUI_DIR"
  npm run dev -- --host 127.0.0.1 --port "$WEB_PORT"
) &
PIDS+=("$!")

echo
echo "photo-web is starting:"
echo "  API: http://127.0.0.1:$API_PORT/api/health"
echo "  UI:  http://127.0.0.1:$WEB_PORT"
echo
echo "Press Ctrl-C to stop both servers."

while true; do
  for pid in "${PIDS[@]}"; do
    if ! kill -0 "$pid" 2>/dev/null; then
      echo "A dev server exited; shutting down the rest."
      exit 1
    fi
  done
  sleep 1
done
