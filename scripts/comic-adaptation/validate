#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$ROOT_DIR/scripts/comic-adaptation/lib.sh"

usage() {
  cat <<'EOF'
Usage:
  scripts/comic-adaptation/validate <project-slug>
  scripts/comic-adaptation/validate books/<book-id>  # deprecated

Validates generated comic-adaptation text artifacts without invoking Pi.
EOF
}

failures=0

fail() {
  echo "FAIL: $*"
  failures=$((failures + 1))
}

pass() {
  echo "OK:   $*"
}

slugify_name() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    tr -cs 'a-z0-9' '-' |
    sed 's/^-//; s/-$//'
}

file_has() {
  local path="$1"
  local text="$2"
  awk -v text="$text" 'index($0, text) { found=1 } END { exit found ? 0 : 1 }' "$path"
}

nonempty() {
  local path="$1"
  [[ -s "$path" ]]
}

has_chat_wrapper() {
  local path="$1"
  awk 'BEGIN { bad=0 } /^(Sure|Here is|Here'\''s|I wrote|Done\.|```|Apologies|I'\''m sorry)/ { bad=1 } END { exit bad ? 0 : 1 }' "$path"
}

validate_common_file() {
  local path="$1"
  if [[ ! -f "$path" ]]; then
    fail "$path missing"
    return 1
  fi
  if ! nonempty "$path"; then
    fail "$path empty"
    return 1
  fi
  if has_chat_wrapper "$path"; then
    fail "$path contains chat wrapper text"
    return 1
  fi
  return 0
}

validate_style_refs() {
  echo
  echo "Style refs"

  validate_common_file "$BOOK_ROOT/style-refs/visual-style.md" || true
  for label in "Style:" "Color palette:" "Realism:" "Lighting:"; do
    if [[ -f "$BOOK_ROOT/style-refs/visual-style.md" ]] && file_has "$BOOK_ROOT/style-refs/visual-style.md" "$label"; then
      pass "visual-style.md has $label"
    else
      fail "visual-style.md missing $label"
    fi
  done

  validate_common_file "$BOOK_ROOT/style-refs/archetype-character.md" && pass "archetype-character.md present" || true
  validate_common_file "$BOOK_ROOT/style-refs/archetype-scene.md" && pass "archetype-scene.md present" || true
}

validate_character_list() {
  echo
  echo "Characters"

  if ! validate_common_file "$BOOK_ROOT/characters/list.txt"; then
    return
  fi

  expected_characters=0
  while IFS= read -r character_line; do
    [[ -n "$character_line" ]] || continue
    expected_characters=$((expected_characters + 1))
    if [[ "$character_line" != *:* ]]; then
      fail "character list line missing colon: $character_line"
    fi
    if [[ "$character_line" == *:*:* ]]; then
      fail "character list line has more than one colon: $character_line"
    fi

    character_name="${character_line%%:*}"
    slug="$(slugify_name "$character_name")"
    artifact="$BOOK_ROOT/characters/artifacts/$slug.md"
    sheet="$BOOK_ROOT/characters/sheets/$slug.md"

    validate_character_artifact "$artifact"
    validate_character_sheet "$sheet"
  done < "$BOOK_ROOT/characters/list.txt"

  pass "checked $expected_characters character list entries"
}

validate_character_artifact() {
  local path="$1"
  validate_common_file "$path" || return 0

  for required in "## Summary" "## Visual Description" "## Visual Variants" "## Source References"; do
    if file_has "$path" "$required"; then
      :
    else
      fail "$path missing $required"
    fi
  done
}

validate_character_sheet() {
  local path="$1"
  validate_common_file "$path" || return 0

  for required in "mode:" "style_ref:" "Layout: top row" "Expressions:"; do
    if file_has "$path" "$required"; then
      :
    else
      fail "$path missing $required"
    fi
  done
}

validate_play_by_play() {
  echo
  echo "Play by play"
  local path="$BOOK_ROOT/acts/play-by-play.md"
  validate_common_file "$path" || return
  for required in "# Play By Play" "Scene Range:" "Purpose:" "Key Beats:"; do
    if file_has "$path" "$required"; then
      :
    else
      fail "$path missing $required"
    fi
  done
}

extract_sections() {
  local input="$1"
  local out_dir="$2"

  rm -rf "$out_dir"
  mkdir -p "$out_dir"
  awk -v out_dir="$out_dir" '
    /^##[[:space:]]+/ {
      if (out) {
        close(out)
      }
      slug=$0
      sub(/^##[[:space:]]+/, "", slug)
      sub(/[[:space:]].*$/, "", slug)
      gsub(/[^A-Za-z0-9_-]/, "-", slug)
      out=out_dir "/" slug ".md"
    }
    out {
      print > out
    }
  ' "$input"
}

validate_scene_manifest_and_artifacts() {
  echo
  echo "Scenes"

  if ! validate_common_file "$BOOK_ROOT/scenes/manifest.md"; then
    return
  fi

  tmp_dir="$BOOK_ROOT/scenes/.validate-entries"
  extract_sections "$BOOK_ROOT/scenes/manifest.md" "$tmp_dir"

  entries=()
  while IFS= read -r entry; do
    entries+=("$entry")
  done < <(ls "$tmp_dir"/*.md 2>/dev/null || true)

  if [[ "${#entries[@]}" -eq 0 ]]; then
    fail "scenes/manifest.md has no ## scene sections"
    return
  fi

  for entry in "${entries[@]}"; do
    slug="$(basename "$entry" .md)"
    for required in "Title:" "Source Lines:" "Major Act:" "Primary Location:" "Characters:" "Props And Visual Assets:"; do
      if file_has "$entry" "$required"; then
        :
      else
        fail "scenes/manifest.md section $slug missing $required"
      fi
    done
    validate_scene_artifact "$BOOK_ROOT/scenes/artifacts/$slug.md"
  done

  pass "checked ${#entries[@]} scene entries"
}

validate_scene_artifact() {
  local path="$1"
  validate_common_file "$path" || return 0
  for required in "Scene Id:" "## Story Function" "## Visual Continuity" "## Dramatic Beats" "## Staging Notes"; do
    if file_has "$path" "$required"; then
      :
    else
      fail "$path missing $required"
    fi
  done
}

validate_locations() {
  echo
  echo "Locations"

  if ! validate_common_file "$BOOK_ROOT/locations/index.md"; then
    return
  fi

  tmp_dir="$BOOK_ROOT/locations/.validate-entries"
  extract_sections "$BOOK_ROOT/locations/index.md" "$tmp_dir"

  entries=()
  while IFS= read -r entry; do
    entries+=("$entry")
  done < <(ls "$tmp_dir"/*.md 2>/dev/null || true)

  if [[ "${#entries[@]}" -eq 0 ]]; then
    fail "locations/index.md has no ## location sections"
    return
  fi

  for entry in "${entries[@]}"; do
    slug="$(basename "$entry" .md)"
    for required in "Name:" "Type:" "Source References:" "Visual Traits:"; do
      if file_has "$entry" "$required"; then
        :
      else
        fail "locations/index.md section $slug missing $required"
      fi
    done

    prompt="$BOOK_ROOT/locations/prompts/$slug.md"
    validate_location_prompt "$prompt"
  done

  pass "checked ${#entries[@]} location entries"
}

validate_story_layouts() {
  echo
  echo "Story layouts"

  layout_count=0
  while IFS= read -r path; do
    [[ -f "$path" ]] || continue
    layout_count=$((layout_count + 1))
    validate_story_layout "$path"
  done < <(ls "$BOOK_ROOT"/pages/plans/*.md "$BOOK_ROOT"/panels/prompts/*.md 2>/dev/null || true)

  if [[ "$layout_count" -eq 0 ]]; then
    fail "no page plans or panel prompts found"
    return
  fi
  pass "checked $layout_count story layout files"
}

validate_story_layout() {
  local path="$1"
  validate_common_file "$path" || return 0
  for required in "mode: story-layout" "refs:" "No watermarks."; do
    if file_has "$path" "$required"; then
      :
    else
      fail "$path missing $required"
    fi
  done
}

validate_location_prompt() {
  local path="$1"
  validate_common_file "$path" || return 0

  for required in "mode:" "style_ref:" "No characters, no text, no labels, no watermarks."; do
    if file_has "$path" "$required"; then
      :
    else
      fail "$path missing $required"
    fi
  done

  if awk '/Environment reference for|Location prompt for/ { bad=1 } END { exit bad ? 0 : 1 }' "$path"; then
    fail "$path contains metadata-style opener"
  fi

  if awk '/`L[0-9][0-9][0-9]|LINE-VERIFY/ { bad=1 } END { exit bad ? 0 : 1 }' "$path"; then
    fail "$path contains source citation text"
  fi
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

[[ "$PWD" == "$ROOT_DIR" ]] || {
  echo "error: Run from repo root: $ROOT_DIR" >&2
  exit 1
}

resolve_adaptation_target "$1"
BOOK_ROOT="$ADAPTATION_ROOT"
[[ -d "$BOOK_ROOT" ]] || {
  echo "error: Missing adaptation root: $BOOK_ROOT" >&2
  exit 1
}

validate_style_refs
validate_character_list
validate_play_by_play
validate_scene_manifest_and_artifacts
validate_locations
validate_story_layouts

echo
if [[ "$failures" -eq 0 ]]; then
  echo "Validation passed."
else
  echo "Validation failed with $failures issue(s)."
  exit 1
fi
