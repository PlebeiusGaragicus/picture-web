#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
source "$ROOT_DIR/scripts/comic-adaptation/lib.sh"
API_BASE="${API_BASE:-http://127.0.0.1:8787}"

usage() {
  cat <<'EOF'
Usage:
  scripts/comic-adaptation/generate-character-sheet <project-slug>

Generates one missing base character sheet asset and records it in adaptation.json.

Environment:
  API_BASE  API server URL (default: http://127.0.0.1:8787)
EOF
}

die() {
  echo "error: $*" >&2
  exit 1
}

need_command() {
  command -v "$1" >/dev/null 2>&1 || die "Missing required command: $1"
}

slugify_name() {
  printf '%s\n' "$1" |
    tr '[:upper:]' '[:lower:]' |
    tr -cs 'a-z0-9' '-' |
    sed 's/^-//; s/-$//'
}

api_get() {
  local path="$1"
  curl -fsS "$API_BASE$path"
}

api_post_json() {
  local path="$1"
  local json="$2"
  curl -fsS \
    -H "Content-Type: application/json" \
    -X POST \
    --data "$json" \
    "$API_BASE$path"
}

import_reference_if_needed() {
  local project_slug="$1"
  local image_path="$2"

  echo "Importing reference image: $image_path" >&2
  curl -fsS \
    -X POST \
    -F "file=@${image_path};type=image/png" \
    -F "kind=archetype-character" \
    "$API_BASE/api/projects/$project_slug/adaptation/import-style-ref" >/dev/null
}

if [[ $# -ne 1 ]]; then
  usage
  exit 2
fi

[[ "$PWD" == "$ROOT_DIR" ]] || die "Run from repo root: $ROOT_DIR"

resolve_adaptation_target "$1"
BOOK_ROOT="$ADAPTATION_ROOT"
[[ -d "$BOOK_ROOT" ]] || die "Missing adaptation root: $BOOK_ROOT"
[[ -z "$LEGACY_BOOK_ROOT" ]] || die "Image generation now requires a project slug, not deprecated books/ input"

need_command curl
need_command jq
need_command awk
need_command sed
need_command tr

api_get "/api/health" >/dev/null || die "API is not reachable at $API_BASE"

STYLE_REF="$BOOK_ROOT/style-refs/archetype-character.png"

[[ -f "$STYLE_REF" ]] || die "Missing character style reference: $STYLE_REF"
[[ -f "photo-library/projects/$PROJECT_SLUG/project.json" ]] || die "Project not found: $PROJECT_SLUG"

if ! api_get "/api/projects/$PROJECT_SLUG/adaptation" | jq -e '.styleRefs.archetypeCharacterAsset' >/dev/null; then
  import_reference_if_needed "$PROJECT_SLUG" "$STYLE_REF"
fi

response="$(api_post_json "/api/projects/$PROJECT_SLUG/adaptation/generate-next-character-sheet" '{}')"
message="$(printf '%s' "$response" | jq -r '.message')"
asset_id="$(printf '%s' "$response" | jq -r '.asset.id // empty')"

if [[ -n "$asset_id" ]]; then
  echo "$message asset=$asset_id"
else
  echo "$message"
fi
